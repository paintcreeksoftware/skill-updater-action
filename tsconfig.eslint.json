{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "__fixtures__/**/*",
    "eslint.config.mjs",
    "jest.config.js",
    "rollup.config.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules"]
}
